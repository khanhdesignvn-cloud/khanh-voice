# Environment configuration for Khanh Voice Training / TTS

# VieNeu-TTS Local Configuration
VIENEU_ENABLED=true
VIENEU_EMOTION=storytelling
VIENEU_TEMPO=0.88
VIENEU_REF_AUDIO=voice-references/khanh-podcast-reference.wav

# Cloud TTS Fallback API Keys (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Achird
OPENROUTER_API_KEY=

# --- Key-selling web app (app/) ---

# Public URL of the deployed site (no trailing slash). Used for PayOS
# return/cancel URLs and to self-register the payment webhook.
PUBLIC_BASE_URL=https://voice.yourdomain.com

# Random long strings — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_PASSWORD=

# PayOS merchant credentials — https://payos.vn (Kênh thanh toán > Cấu hình)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional: override the SQLite file location (default: data/khanhvoice.db)
DATABASE_PATH=
