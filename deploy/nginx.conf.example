# Reverse proxy for Khanh Voice. Copy to /etc/nginx/sites-available/khanh-voice,
# replace voice.yourdomain.com, then:
#   sudo ln -s /etc/nginx/sites-available/khanh-voice /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d voice.yourdomain.com   # issues free TLS cert (Let's Encrypt)

server {
    listen 80;
    server_name voice.yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
